APP_MODE="demo"

# Comma-separated hostnames or full URLs allowed in `next dev` when not using localhost.
# Example: 192.168.5.9 or http://192.168.5.9:3000
DEV_ALLOWED_ORIGINS="192.168.5.9"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_video_assistant"
REDIS_URL="redis://localhost:6379"

# Object storage — MinIO locally (docker compose) or Cloudflare R2 in production
OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:9000"
OBJECT_STORAGE_BUCKET="ai-video-assistant"
OBJECT_STORAGE_ACCESS_KEY_ID="minioadmin"
OBJECT_STORAGE_SECRET_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_REGION="us-east-1"
# Optional CDN/public URL prefix for browser-accessible assets
OBJECT_STORAGE_PUBLIC_URL=""

# Auth (NextAuth v5) — AUTH_SECRET is required; generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Resend email service (magic-link login)
RESEND_API_KEY=""
EMAIL_FROM="AI短视频助手 <noreply@resend.dev>"

# Sentry error monitoring (optional — omit SENTRY_DSN to disable)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# WeChat OAuth (optional — omit WECHAT_APP_ID to disable WeChat login)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

OPENAI_API_KEY=""
# OpenAI-compatible base URL (e.g. https://api.openai.com/v1 or DeepSeek/other compatible endpoint)
OPENAI_BASE_URL=""
AVATAR_PROVIDER="heygen"
AVATAR_PROVIDER_API_KEY=""
# Pre-configured HeyGen avatar + voice (find via HeyGen dashboard or
# GET /v3/avatars/looks). When AVATAR_TEMPLATE_ID is unset, the adapter tries
# to resolve a public stock avatar at runtime; set these for deterministic runs.
HEYGEN_AVATAR_TEMPLATE_ID=""
HEYGEN_VOICE_ID=""
# Async render polling: interval between status checks, and max attempts
# (attempts * interval ≈ overall ceiling, default ~5 min before TTS fallback).
HEYGEN_POLL_INTERVAL_MS="5000"
HEYGEN_POLL_MAX_ATTEMPTS="60"

# ── 火山引擎「实拍对口型」供应商（AVATAR_PROVIDER=volcengine-lipsync 时启用）──
# 新形象默认创建路径：上传实拍口播视频 → 豆包 TTS 配音 → MediaKit 改口型。
# 注意两个 Key 分属不同产品线，各自控制台申请，不通用（2026-09-16 实测 401）。
# MediaKit API Key：火山引擎 AI MediaKit 控制台
MEDIKIT_API_KEY=""
# MEDIKIT_BASE_URL 默认 https://mediakit.cn-beijing.volces.com，跨区域才改
# MEDIKIT_POLL_INTERVAL_MS="15000"
# MEDIKIT_POLL_TIMEOUT_MS="2400000"
# 豆包语音合成 API Key：语音技术控制台「API Key 管理」（先开通豆包语音合成大模型 2.0）
DOUBAO_TTS_API_KEY=""
# TTS 2.0 音色（发音人 id，音色列表见文档 6561/1257544；注意须为 _uranus_bigtts 后缀的 2.0 音色）
# DOUBAO_TTS_VOICE="zh_female_vv_uranus_bigtts"
# 计费/模型资源位：标准音色 seed-tts-2.0；声音复刻上线后 seed-icl-2.0
# DOUBAO_TTS_RESOURCE_ID="seed-tts-2.0"
